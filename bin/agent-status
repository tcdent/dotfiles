#!/usr/bin/env bash
# agent-status: input-availability report for registered agents.
#
# Reports whether each agent's input prompt is available (can receive
# messages) or unavailable (blocked on a dialog or other state).
#
# Response format: <available|unavailable>:<reason>
#
#   available:unknown               Input prompt visible; background state unknown
#   unavailable:requires_approval   Local permission dialog ("Do you want to proceed?")
#   unavailable:survey              End-of-session feedback survey
#   unavailable:unknown             Input not available; unrecognized state
#
# Only panes running claude with a registered identity are reported.
#
# Usage:
#   agent-status                        All registered agents, text
#   agent-status --json                 One ndjson record per agent
#   agent-status <identity>             Single agent lookup
#   agent-status <identity> --json      Single agent, json
#   agent-status -h | --help

set -euo pipefail

die() { echo "error: $*" >&2; exit 1; }

# --- Identity extraction (from agent-message) ---

identity_from_title() {
  printf '%s\n' "$1" | grep -oE '[a-zA-Z0-9._-]+@[a-zA-Z0-9._-]+' | head -1 || true
}

# --- Pane content ---

capture_stripped() {
  local pane="$1"
  local content
  content=$(tmux capture-pane -t "$pane" -p 2>/dev/null) || return 1
  printf '%s\n' "$content" | sed -e :a -e '/^[[:space:]]*$/{ $d; N; ba; }'
}

# --- Input-availability check ---
# [PROVEN: agent-restart + agent-message, exercised across 20+ agents]
# The ❯ + NBSP (U+00A0) pattern on the input line means the prompt is
# accepting input. Remote hooks don't block this — the prompt is visible
# even during http-hook waits, so "available" means "can receive messages."

is_input_available() {
  local content="$1"
  printf '%s\n' "$content" | tail -10 | grep -qP '^❯\x{00a0}($| )'
}

# --- Unavailable-state detectors ---

# [PROVEN: agent-blocked-poll, fixtures 01-03, live-validated]
# Local permission dialog: "Do you want to proceed?" + numbered menu selector.
# Only fires for non-hooked tools or when triage returns "ask".
is_approval_prompt() {
  local content="$1"
  local tail30
  tail30=$(printf '%s\n' "$content" | tail -30)
  if printf '%s\n' "$tail30" | grep -qF 'Do you want to proceed?' &&
     printf '%s\n' "$tail30" | grep -qP '^ \xe2\x9d\xaf [0-9]+\.'; then
    return 0
  fi
  return 1
}

# [DOCUMENTED: agent-blocked-poll fixture 04, observed on two.lead]
# End-of-session feedback survey. Blocks input until answered or dismissed.
is_feedback_survey() {
  local content="$1"
  printf '%s\n' "$content" | tail -15 | grep -qF 'How is Claude doing this session?'
}

# --- Classifier ---

classify_pane() {
  local pane="$1"
  local cmd
  cmd=$(tmux display-message -t "$pane" -p '#{pane_current_command}' 2>/dev/null || true)
  [[ "$cmd" != "claude" ]] && return 1

  local content
  content=$(capture_stripped "$pane") || return 1

  if is_input_available "$content"; then
    echo "available:unknown"
    return
  fi

  if is_approval_prompt "$content"; then
    echo "unavailable:requires_approval"
    return
  fi

  if is_feedback_survey "$content"; then
    echo "unavailable:survey"
    return
  fi

  echo "unavailable:unknown"
}

# --- Output ---

emit_text() {
  local identity="$1" pane="$2" status="$3"
  printf '  %-40s %-12s %s\n' "$identity" "$pane" "$status"
}

emit_json() {
  local identity="$1" pane="$2" status="$3"
  local input="${status%%:*}"
  local reason="${status#*:}"
  IDENTITY="$identity" PANE="$pane" INPUT="$input" REASON="$reason" \
    python3 -c '
import json, os
print(json.dumps({
    "identity": os.environ["IDENTITY"],
    "pane": os.environ["PANE"],
    "input": os.environ["INPUT"],
    "reason": os.environ["REASON"],
}))
'
}

# --- Main ---

JSON=0
TARGET=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --json) JSON=1 ;;
    -h|--help|help)
      cat <<'HELPEOF'
Usage:
  agent-status                        All registered agents, text
  agent-status --json                 All registered agents, ndjson
  agent-status <identity>             Single agent
  agent-status <identity> --json      Single agent, json

Responses:
  available:unknown               Input prompt visible
  unavailable:requires_approval   Local permission dialog blocking input
  unavailable:survey              Feedback survey blocking input
  unavailable:unknown             Input not available, unrecognized state

Exit 0 always (status is informational).
HELPEOF
      exit 0
      ;;
    -*) die "unknown flag: $1" ;;
    *) TARGET="$1" ;;
  esac
  shift
done

ANY=0
while IFS=$'\t' read -r addr cmd title; do
  [[ "$cmd" != "claude" ]] && continue
  identity=$(identity_from_title "$title")
  [[ -z "$identity" ]] && continue

  if [[ -n "$TARGET" ]]; then
    if [[ "$TARGET" != "$identity" && "$TARGET" != "${identity%@*}" ]]; then
      continue
    fi
  fi

  status=$(classify_pane "$addr") || continue

  if [[ $JSON -eq 1 ]]; then
    emit_json "$identity" "$addr" "$status"
  else
    emit_text "$identity" "$addr" "$status"
  fi
  ANY=1
done < <(tmux list-panes -a -F "#{session_name}:#{window_index}.#{pane_index}	#{pane_current_command}	#{pane_title}")

if [[ $ANY -eq 0 && -n "$TARGET" ]]; then
  die "no registered agent found for '$TARGET'"
fi

exit 0
