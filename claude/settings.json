{
  "env": {
    "NOMAD_ADDR": "http://192.168.88.2:4646"
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:*)",
      "WebSearch"
    ],
    "deny": [],
    "ask": [],
    "additionalDirectories": [
      "/Users/tcdent/Work/cat"
    ]
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '\\a'"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "input=$(cat); used=$(echo \"$input\" | jq -r '.context_window.used_percentage // empty'); dir=$(echo \"$input\" | jq -r '.workspace.current_dir' | sed \"s|^$HOME|~|\"); host=$(hostname -s); if [ -n \"$used\" ]; then printf '%s:%s ctx:%s%%' \"$host\" \"$dir\" \"$(printf '%.0f' \"$used\")\"; else printf '%s:%s' \"$host\" \"$dir\"; fi"
  },
  "sandbox": {
    "enabled": false
  },
  "alwaysThinkingEnabled": true,
  "promptSuggestionEnabled": false,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "includeCoAuthoredBy": false,
  "switchModelsOnFlag": false,
  "fileCheckpointingEnabled": false,
  "remoteControlAtStartup": true,
  "agentPushNotifEnabled": true
}
